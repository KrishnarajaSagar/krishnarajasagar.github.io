---
const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || pathname.startsWith(href + "/") || (href === "/me" && pathname === "/");
---

<header style="border-bottom: 1px solid var(--border); position: sticky; top: 0; background: var(--header-bg); backdrop-filter: blur(8px); z-index: 10;">
  <div class="container header-inner" style="display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0.85rem 1.25rem; gap: 1rem;">
    <a href="/me" class="brand" aria-label="Krishnaraja Sagar" style="justify-self: start;">
      <span class="brand__stack">
        <span class="brand__text">KRISHNARAJA SAGAR</span>
        <span class="brand__phonetic" aria-hidden="true">/krɪʃnəˌrɑːdʒə ˈsɑːɡər/</span>
      </span>
    </a>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
      <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <nav class="desktop-nav" aria-label="Primary" style="display: flex; gap: 1.25rem; align-items: center; justify-self: end;">
      <a href="/me" aria-current={isActive("/me") ? "page" : undefined} style={`font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: ${isActive("/me") ? "var(--text)" : "var(--text-muted)"}; text-decoration: none; border-bottom: ${isActive("/me") ? "1px solid var(--text)" : "1px solid transparent"}; padding-bottom: 2px;`}>Me</a>
      <a href="/life" aria-current={isActive("/life") ? "page" : undefined} style={`font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: ${isActive("/life") ? "var(--text)" : "var(--text-muted)"}; text-decoration: none; border-bottom: ${isActive("/life") ? "1px solid var(--text)" : "1px solid transparent"}; padding-bottom: 2px;`}>Life</a>
      <a href="/work" aria-current={isActive("/work") ? "page" : undefined} style={`font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.08em; text-transform: uppercase; color: ${isActive("/work") ? "var(--text)" : "var(--text-muted)"}; text-decoration: none; border-bottom: ${isActive("/work") ? "1px solid var(--text)" : "1px solid transparent"}; padding-bottom: 2px;`}>Work</a>
    </nav>
    <button id="menu-toggle" class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav aria-label="Mobile">
      <a href="/me" aria-current={isActive("/me") ? "page" : undefined}>Me</a>
      <a href="/life" aria-current={isActive("/life") ? "page" : undefined}>Life</a>
      <a href="/work" aria-current={isActive("/work") ? "page" : undefined}>Work</a>
    </nav>
    <hr />
    <button class="theme-toggle theme-toggle--menu" type="button" aria-pressed="false">
      <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <span class="theme-toggle__label">Dark mode</span>
    </button>
  </div>
</header>

<script is:inline>
  (() => {
    const brand = document.querySelector(".brand");
    if (!brand) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (window.matchMedia("(max-width: 480px)").matches) return;
    if (location.pathname.startsWith("/work")) return;
    const stack = brand.querySelector(".brand__stack");
    const text = brand.querySelector(".brand__text");
    const phonetic = brand.querySelector(".brand__phonetic");
    if (!stack || !text || !phonetic) return;

    // Lock width to prevent layout shift
    const lockWidth = () => {
      const w = Math.max(text.offsetWidth, phonetic.offsetWidth);
      stack.style.minWidth = w + "px";
    };
    lockWidth();
    window.addEventListener("resize", lockWidth);

    let glitching = false;
    let timeout;
    let holdTimeout;
    let backTimeout;
    const trigger = () => {
      if (glitching) return;
      if (document.hidden) return;
      glitching = true;
      brand.classList.add("glitching");
      brand.classList.add("show-phonetic");
      // 1s glitch to phonetic
      timeout = setTimeout(() => {
        brand.classList.remove("glitching");
      }, 1000);
      // hold 1.2s, then glitch back to original
      holdTimeout = setTimeout(() => {
        brand.classList.add("glitching-back");
        backTimeout = setTimeout(() => {
          brand.classList.remove("glitching-back");
          brand.classList.remove("show-phonetic");
          glitching = false;
          schedule();
        }, 1000);
      }, 2200);
    };
    const schedule = () => {
      const delay = 3000 + Math.random() * 2000; // 3-5s
      setTimeout(trigger, delay);
    };
    schedule();

    // Hover trigger
    brand.addEventListener("mouseenter", () => {
      if (glitching) return;
      clearTimeout(timeout);
      clearTimeout(holdTimeout);
      clearTimeout(backTimeout);
      trigger();
    });
    brand.addEventListener("mouseleave", () => {
      // let current glitch finish, then reschedule
    });
    brand.addEventListener("focusin", trigger);

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden && !glitching) schedule();
    });
  })();
</script>

<script is:inline>
  (() => {
    document.documentElement.classList.add("js");
    const btns = Array.from(document.querySelectorAll(".theme-toggle"));
    const labels = Array.from(document.querySelectorAll(".theme-toggle__label"));
    const sync = () => {
      const dark = document.documentElement.dataset.theme === "dark";
      btns.forEach((b) => {
        b.setAttribute("aria-pressed", String(dark));
        if (b.classList.contains("theme-toggle--menu")) {
          b.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
        } else {
          b.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
        }
        b.dataset.mode = dark ? "dark" : "light";
      });
      labels.forEach((l) => { l.textContent = dark ? "Light mode" : "Dark mode"; });
    };
    sync();
    new MutationObserver(sync).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
    btns.forEach((b) => b.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem("theme", next); } catch {}
      sync();
    }));

    // Mobile menu
    const menuBtn = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    if (!menuBtn || !menu) return;
    const setOpen = (open) => {
      menu.hidden = !open;
      menuBtn.setAttribute("aria-expanded", String(open));
      menuBtn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };
    menuBtn.addEventListener("click", () => setOpen(menu.hidden));
    menu.addEventListener("click", (e) => {
      const link = e.target.closest("a");
      if (link) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.hidden) { setOpen(false); menuBtn.focus(); }
    });
    document.addEventListener("click", (e) => {
      if (!menu.hidden && !e.target.closest("#mobile-menu") && !e.target.closest("#menu-toggle")) setOpen(false);
    });
  })();
</script>

<style>
  .brand {
    display: inline-block;
    text-decoration: none;
    color: var(--text);
    white-space: nowrap;
  }
  .brand__stack {
    display: inline-grid;
    vertical-align: middle;
  }
  .brand__text,
  .brand__phonetic {
    grid-area: 1 / 1;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    line-height: 1;
    transition: opacity 0.08s;
  }
  .brand__phonetic {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.92rem;
    letter-spacing: 0.02em;
    opacity: 0;
    color: var(--text);
  }
  /* Phonetic visible during glitch + hold (2-3s total) */
  .brand.show-phonetic .brand__text {
    opacity: 0;
  }
  .brand.show-phonetic .brand__phonetic {
    opacity: 1;
  }
  /* Tone down: keep glitch text hidden while phonetic shown */
  .brand.glitching .brand__text {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .brand.glitching .brand__text {
      animation: glitchText 1s steps(2, end) forwards;
    }
    .brand.glitching .brand__phonetic {
      animation: glitchPhonetic 1s steps(2, end) forwards;
    }
    .brand.glitching-back .brand__text {
      animation: glitchTextBack 1s steps(2, end) forwards;
    }
    .brand.glitching-back .brand__phonetic {
      animation: glitchPhoneticBack 1s steps(2, end) forwards;
    }
  }

  @keyframes glitchText {
    0% { transform: translate(0); text-shadow: none; opacity: 1; }
    8% { transform: translate(-1.2px, 0.3px); text-shadow: 1.2px 0 #ff3b30, -1.2px 0 #007aff; opacity: 0.9; }
    12% { transform: translate(1.4px, -0.3px); text-shadow: -1.2px 0 #ff3b30, 1.2px 0 #007aff; }
    18% { transform: translate(-0.8px, 0); opacity: 0; }
    22% { transform: translate(1px, 0.2px); text-shadow: 1px 0 #ff3b30, -1px 0 #007aff; opacity: 1; }
    30% { transform: translate(-1px, -0.2px); clip-path: inset(0 0 45% 0); }
    36% { transform: translate(1.1px, 0); clip-path: inset(55% 0 0 0); }
    42% { opacity: 0; }
    48% { opacity: 1; transform: translate(0); text-shadow: none; clip-path: none; }
    100% { opacity: 0; }
  }

  @keyframes glitchPhonetic {
    0% { transform: translate(0); text-shadow: none; opacity: 0; }
    10% { opacity: 1; transform: translate(1.1px, 0); text-shadow: -1.3px 0 #ff3b30, 1.3px 0 #007aff; }
    16% { transform: translate(-1.3px, 0.2px); text-shadow: 1.2px 0 #007aff, -1.2px 0 #ff3b30; }
    24% { transform: translate(0.9px, -0.2px); clip-path: inset(0 0 50% 0); }
    32% { transform: translate(-1px, 0); clip-path: inset(40% 0 0 0); }
    40% { text-shadow: 1.3px 0 #ff3b30, -1.3px 0 #007aff; }
    50% { opacity: 1; }
    88% { opacity: 1; transform: translate(0); text-shadow: 1.3px 0 #ff3b30, -1.3px 0 #007aff; }
    100% { opacity: 0; transform: translate(0); text-shadow: none; }
  }

  @keyframes glitchTextBack {
    0% { transform: translate(0); text-shadow: none; opacity: 0; }
    12% { opacity: 1; transform: translate(-1.1px, 0.2px); text-shadow: 1.3px 0 #007aff, -1.3px 0 #ff3b30; }
    20% { transform: translate(1.2px, -0.2px); text-shadow: -1.3px 0 #ff3b30, 1.3px 0 #007aff; clip-path: inset(45% 0 0 0); }
    30% { transform: translate(-1px, 0); clip-path: inset(0 0 45% 0); }
    42% { opacity: 1; transform: translate(1px, 0); text-shadow: 1.2px 0 #ff3b30, -1.2px 0 #007aff; }
    100% { opacity: 1; transform: translate(0); text-shadow: none; }
  }

  @keyframes glitchPhoneticBack {
    0% { opacity: 1; transform: translate(0); text-shadow: 1.3px 0 #ff3b30, -1.3px 0 #007aff; }
    12% { transform: translate(1.3px, 0.2px); text-shadow: -1.2px 0 #007aff, 1.2px 0 #ff3b30; }
    22% { transform: translate(-1.2px, -0.3px); clip-path: inset(50% 0 0 0); }
    34% { transform: translate(1px, 0); clip-path: inset(0 0 50% 0); opacity: 1; }
    48% { opacity: 0; transform: translate(-1.1px, 0); text-shadow: -1.3px 0 #ff3b30, 1.3px 0 #007aff; }
    100% { opacity: 0; transform: translate(0); text-shadow: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand__phonetic { display: none !important; }
    .brand.glitching .brand__text { opacity: 1 !important; animation: none !important; }
  }

  .theme-toggle {
    justify-self: center;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    background: none;
    border: 1px solid transparent;
    border-radius: 50%;
    cursor: pointer;
    color: var(--text-muted);
    transition: color 0.15s ease, border-color 0.15s ease;
    padding: 0;
  }
  .theme-toggle:hover { color: var(--accent); border-color: var(--border); }
  .theme-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .theme-toggle .icon-sun { display: none; }
  .theme-toggle[data-mode="dark"] .icon-sun { display: block; }
  .theme-toggle[data-mode="dark"] .icon-moon { display: none; }

  .menu-toggle {
    display: none;
    justify-self: end;
    width: 40px;
    height: 40px;
    place-items: center;
    background: none;
    border: 1px solid transparent;
    border-radius: 8px;
    cursor: pointer;
    color: var(--text);
  }
  .menu-toggle:hover { border-color: var(--border); color: var(--accent); }
  .menu-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .mobile-menu {
    position: absolute;
    top: 100%;
    right: 1rem;
    min-width: 220px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
    padding: 0.5rem;
    z-index: 20;
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu nav { display: flex; flex-direction: column; }
  .mobile-menu nav a {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-muted);
    padding: 0.7rem 0.8rem;
    border-radius: 6px;
  }
  .mobile-menu nav a:hover { background: var(--bg-subtle); color: var(--text); text-decoration: none; }
  .mobile-menu nav a[aria-current="page"] { color: var(--text); background: var(--bg-subtle); }
  .mobile-menu hr { border: none; border-top: 1px solid var(--border); margin: 0.4rem 0; }
  .theme-toggle--menu {
    width: 100%;
    height: auto;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border-radius: 6px;
    padding: 0.7rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Hamburger only takes over when JS can open it (html.js); no-JS keeps desktop nav.
     !important beats the inline display/grid styles on .header-inner/.desktop-nav. */
  @media (max-width: 640px) {
    html.js .desktop-nav, html.js #theme-toggle { display: none !important; }
    html.js .menu-toggle { display: grid; }
    html.js .header-inner { grid-template-columns: 1fr auto !important; }
    .theme-toggle--menu { justify-self: stretch; }
  }

  @media (max-width: 480px) {
    header div { gap: 0.75rem; }
    .header-inner { gap: 0.5rem; }
    .brand__text { font-size: 0.9rem; }
    .brand__phonetic { display: none; }
    #theme-toggle { width: 28px; height: 28px; }
    .theme-toggle--menu { width: 100%; height: auto; }
  }
</style>
