---
import Base from "../../../layouts/Base.astro";
import booksData from "../../../data/books.json";
---

<Base title="Books — Life — Sagar" description="Books — title, author, year.">
  <div class="container" style="padding: 2rem 1.25rem;">
    <p class="meta"><a href="/life">Life</a> / Books</p>
    <h1 style="margin: 0.5rem 0;">Books</h1>
    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Portals to unknown worlds.</p>
    <hr class="divider" />
    {booksData.length===0 ? <p style="color: var(--text-muted);">No books yet — add to <code>src/data/books.json</code></p> : (
      <div class="table-scroll" style="border: 1px solid var(--border); overflow-x: auto;">
        <table class="data-table" style="width: 100%; border-collapse: collapse; font-size: 0.92rem; min-width: 560px;">
          <thead>
            <tr style="text-align: left; border-bottom: 1px solid var(--border-strong); background: var(--bg-subtle);">
              <th style="padding: 0.6rem 0.8rem; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase;">Title</th>
              <th style="padding: 0.6rem 0.8rem; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase;">Author</th>
              <th style="padding: 0.6rem 0.8rem; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase;">Year</th>
              <th style="padding: 0.6rem 0.8rem; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase;">Tags</th>
            </tr>
          </thead>
          <tbody>
            {booksData.map((b: any) => (
              <tr style="border-bottom: 1px solid var(--border);">
                <td style="padding: 0.6rem 0.8rem; font-family: var(--font-serif); font-weight: 600;">{b.title}</td>
                <td style="padding: 0.6rem 0.8rem; color: var(--text-muted);">{b.author}</td>
                <td style="padding: 0.6rem 0.8rem; font-family: var(--font-mono); font-size: 0.78rem;">{b.year}</td>
                <td style="padding: 0.6rem 0.8rem;"><span style="font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-muted);">{b.tags?.join(" · ")}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
    <p style="font-family: var(--font-mono); font-size: 0.78rem; margin-top: 1rem;"><a href="/life">← Life hub</a></p>
  </div>
</Base>

<style>
  @media (max-width: 560px) {
    .data-table th:last-child, .data-table td:last-child { display: none; }
    .data-table { min-width: 0; }
  }
</style>
