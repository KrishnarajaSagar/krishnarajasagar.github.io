---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
export async function getStaticPaths() {
  const entries = await getCollection("work", ({data})=> data.status!=="draft");
  return entries.map((entry)=> ({ params:{ slug: entry.id }, props:{ entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const fmtLong = (d: Date) => d.toLocaleDateString("en-GB", { month: "long", year: "numeric" });
const fmtRange = (s: Date, e?: Date | string) => {
  const start = fmtLong(s);
  if (!e) return start;
  if (typeof e === "string") return `${start} – ${e}`;
  return `${start} – ${fmtLong(e)}`;
};
---
<Base title={`${entry.data.title} — Work — Sagar`} description={entry.data.description}>
  <article class="container" style="padding: 2rem 1.25rem;">
    <p class="meta"><a href="/work">Work</a></p>
    <h1 style="margin: 0.5rem 0 0.4rem;">{entry.data.title}</h1>
    <p class="meta" style="margin-bottom:0.6rem;">{[entry.data.role, entry.data.employer].filter(Boolean).join(" · ")}{` · ${fmtRange(entry.data.date, (entry.data as any).endDate)}`}</p>
    {entry.data.description && <p style="color: var(--text-muted); max-width:60ch; margin-bottom:1.25rem;">{entry.data.description}</p>}
    <hr class="divider" style="max-width: var(--max-width);" />
    <div class="prose"><Content /></div>
    <hr class="divider" style="max-width: var(--max-width);" />
    <p style="font-family: var(--font-mono); font-size:0.78rem;"><a href="/work">← All work</a></p>
  </article>
</Base>
